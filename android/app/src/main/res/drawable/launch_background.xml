<?xml version="1.0" encoding="utf-8"?>
<!-- Dark launch screen with the EZ waveform mark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.25"
                android:centerY="0.1"
                android:gradientRadius="620dp"
                android:startColor="#25201F"
                android:endColor="#0B0C0F" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
